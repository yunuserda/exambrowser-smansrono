{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Exambrowser",
  "version": "1.0.0",
  "identifier": "com.smanteg.exambrowser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Exambrowser SMANTEG",
        "fullscreen": true,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}